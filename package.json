{
  "name": "account-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../account/openapi/account-api.yaml -o src/api/generated/schema.d.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{vue,css}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "element-plus": "2.14.4",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.73.0",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-vue": "10.9.2",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "npm-run-all2": "9.0.3",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.73.0",
    "prettier": "3.9.5",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.10"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.19.0"
  }
}
